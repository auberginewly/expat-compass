[Unit]
Description=Expat Compass Spring Boot Backend (Layered)
After=network.target postgresql.service

[Service]
# 宝塔默认用户通常是 www
User=www
Group=www
WorkingDirectory=/www/wwwroot/expat-compass/backend

# 使用 Spring Boot 3.2+ 的分层启动类
ExecStart=/usr/bin/java -Xms512m -Xmx1024m \
    -Dspring.profiles.active=prod \
    -Djava.io.tmpdir=/www/wwwroot/expat-compass/backend/tmp \
    org.springframework.boot.loader.launch.JarLauncher

# 允许应用在崩溃后 10 秒自动重启
Restart=always
RestartSec=10

# 日志直接交给系统管理或指定文件
StandardOutput=append:/www/wwwroot/expat-compass/backend/logs/app.log
StandardError=append:/www/wwwroot/expat-compass/backend/logs/app.log

[Install]
WantedBy=multi-user.target

